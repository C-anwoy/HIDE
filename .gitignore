# Local inference inputs and append-only working outputs
/data/
/checkpoints/
/outputs/
/tmp/
/output/pdf/*.aux
/output/pdf/*.bbl
/output/pdf/*.blg
/output/pdf/*.log
/output/pdf/*.out
/output/pdf/*.xdv
/.venv/
/.venv-revision/
