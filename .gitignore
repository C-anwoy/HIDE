# Python/build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
/build/
/dist/

# Transfer bundles are generated; verified experiment snapshots under results/ are tracked.
/hide_repository.zip
/hide_revision_bundle.zip

# LaTeX build intermediates
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.synctex.gz
